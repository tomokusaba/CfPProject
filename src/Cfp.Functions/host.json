{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      }
    }
  },
  "extensions": {
    "queues": {
      "batchSize": 8,
      "maxDequeueCount": 5,
      "visibilityTimeout": "00:02:30"
    }
  }
}
